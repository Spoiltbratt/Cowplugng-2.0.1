rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /***********************
     * AUTH HELPERS
     ***********************/
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocData() {
      return userExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function isSuperAdminByEmail() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email is string &&
             (request.auth.token.email.lower() == "tugbobodare4@gmail.com" ||
              request.auth.token.email == "tugbobodare4@gmail.com" || 
              request.auth.token.email == "Tugbobodare4@gmail.com");
    }

    function isSuperAdmin() {
      return isSuperAdminByEmail() ||
             (userExists() && 
              (('role' in userDocData()) && 
               userDocData().role == "super_admin"));
    }

    function isAdmin() {
      return isSuperAdmin() ||
             (userExists() && 
              (('role' in userDocData()) && 
               (userDocData().role == "admin" || userDocData().role == "super_admin" || userDocData().role == "staff")) ||
              (('permissions' in userDocData()) && 
               userDocData().permissions is list && 
               userDocData().permissions.hasAny(['dashboard.view', 'admin.access'])));
    }

    /***********************
     * USER PROFILES
     ***********************/
    match /users {
      allow list: if isSignedIn();
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || 
                    (isSignedIn() && 
                     ('email' in resource.data) && 
                     ('email' in request.auth.token) && 
                     resource.data.email == request.auth.token.email) ||
                    isAdmin();

      allow create: if isSignedIn();

      allow update: if isAdmin() || 
                    (isOwner(uid) && 
                     (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
                     (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions));

      allow delete: if isSuperAdmin();
    }

    /***********************
     * WHOLESALE & B2B
     ***********************/
    match /b2bCustomers/{id} {
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid)) || isOwner(id) || isAdmin();
      allow write: if isOwner(id) || isAdmin() || isSignedIn();
    }

    match /wholesaleRequests/{id} {
      allow create: if isSignedIn();
      allow read: if (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid)) || isAdmin();
      allow update, delete: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isAdmin();
    }

    match /wholesaleOrders/{id} {
      allow read: if (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid)) || isAdmin();
      allow write: if isSignedIn();
    }

    match /wholesalePricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /***********************
     * PUBLIC CONTENT
     ***********************/
    match /opportunities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /investmentPackages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /***********************
     * LIVESTOCK
     ***********************/
    match /livestock/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || 
                    (isSignedIn() && 
                     resource.data.ownerId == request.auth.uid &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liquidationStatus', 'lastUpdated']));
    }

    /***********************
     * INVESTMENT & CONSULTATION
     ***********************/
    match /consultationRequests/{id} {
      allow create: if isSignedIn();
      allow read: if (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.investorId == request.auth.uid)) || isAdmin();
      allow update, delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /paymentReceipts/{id} {
      allow read, write: if isSignedIn();
    }

    match /deliveryRequests/{id} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{id} {
      allow read, write: if isSignedIn();
    }

    match /spendingLedger/{id} {
      allow read, write: if isSignedIn();
    }

    match /liquidationRequests/{requestid} {
      allow read, write: if isSignedIn();
    }

    /***********************
     * OPPORTUNITY APPLICATIONS
     ***********************/
    match /opportunityApplications/{id} {
      allow read, write: if isSignedIn();
    }

    /***********************
     * ANNOUNCEMENTS
     ***********************/
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /***********************
     * ACTIVITY LOGS
     ***********************/
    match /activityLogs/{id} {
      allow read, write: if isSignedIn();
    }

    /***********************
     * HEALTH & GROWTH RECORDS
     ***********************/
    match /healthRecords/{id} {
      allow read: if isAdmin() || 
                    (isSignedIn() && 
                     resource.data.livestockId is string &&
                     exists(/databases/$(database)/documents/livestock/$(resource.data.livestockId)) &&
                     get(/databases/$(database)/documents/livestock/$(resource.data.livestockId)).data.ownerId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /livestockGrowthRecords/{id} {
      allow read: if isAdmin() || 
                    (isSignedIn() && (
                      resource != null &&
                      ('livestockId' in resource.data) &&
                      resource.data.livestockId is string &&
                      exists(/databases/$(database)/documents/livestock/$(resource.data.livestockId)) &&
                      get(/databases/$(database)/documents/livestock/$(resource.data.livestockId)).data.ownerId == request.auth.uid
                    ));
      allow write: if isAdmin();
    }

    match /livestockHealthRecords/{id} {
      allow get: if isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/livestock/$(id)) &&
         get(/databases/$(database)/documents/livestock/$(id)).data.ownerId == request.auth.uid) ||
        (isSignedIn() && resource != null &&
         exists(/databases/$(database)/documents/livestock/$(resource.data.livestockId)) &&
         get(/databases/$(database)/documents/livestock/$(resource.data.livestockId)).data.ownerId == request.auth.uid);
      allow list: if isAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/livestock/$(resource.data.livestockId)) &&
         get(/databases/$(database)/documents/livestock/$(resource.data.livestockId)).data.ownerId == request.auth.uid);
      allow write: if isAdmin();
    }

    /***********************
     * SETTINGS
     ***********************/
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /***********************
     * GENERAL INQUIRIES
     ***********************/
    match /generalInquiries/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    /***********************
     * NOTIFICATIONS & FCM TOKENS
     ***********************/
    match /notifications/{id} {
      allow read: if (isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.userId == 'ADMIN_BROADCAST'
      )) || isAdmin();
      allow create: if isAdmin() || 
                    (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || 
                    (isSignedIn() && 
                     resource.data.userId == request.auth.uid && 
                     request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || 
                    (isSignedIn() && 
                     resource.data.userId == request.auth.uid);
    }

    match /fcmTokens/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /users/{uid}/fcmTokens/{id} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    /***********************
     * DENY EVERYTHING ELSE
     ***********************/
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
